# Copy to .env and fill in. Never commit .env.
# Defaults below run the full stack locally with docker compose + Ollama on your laptop.

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=*

# --- Postgres (any Postgres URL works, including Neon's postgresql://...?sslmode=require) ---
POSTGRES_PASSWORD=docusense
DATABASE_URL=postgresql://docusense:docusense@postgres:5432/docusense

# --- Redis: Celery queue + semantic cache (leave empty to disable the cache) ---
REDIS_URL=redis://redis:6379/0

# --- Ingestion: celery (uses the worker container) | inline (no worker, for free hosting) ---
INGEST_MODE=celery

# --- Vector store (Qdrant Cloud: paste the cluster URL and API key) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docusense_chunks

# --- LLM: ollama (self-hosted, private) | openai (any OpenAI-compatible API, e.g. Groq) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
# Used when LLM_PROVIDER=openai:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# --- Embeddings (fastembed, runs on CPU) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Agent tuning ---
MAX_AGENT_ITERATIONS=2
RETRIEVAL_TOP_K=8
RERANK_KEEP_K=5
MAX_SUB_QUESTIONS=4
SEMANTIC_CACHE_THRESHOLD=0.95
